# syntax=docker/dockerfile:1
# Build the React app, then serve the static bundle with nginx (which also
# proxies /api to webshop-api).

FROM node:22-alpine AS build
WORKDIR /ui
COPY apps/webshop-ui/package.json apps/webshop-ui/package-lock.json* ./
RUN npm install
COPY apps/webshop-ui/ ./
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY apps/webshop-ui/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /ui/dist /usr/share/nginx/html
EXPOSE 80
