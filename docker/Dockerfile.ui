# syntax=docker/dockerfile:1
# Build the React app, then serve the static bundle with nginx (which also
# proxies /api to webshop-api).

FROM node:22-alpine AS build
WORKDIR /ui
COPY apps/webshop-ui/package.json apps/webshop-ui/package-lock.json* ./
RUN npm install
COPY apps/webshop-ui/ ./
RUN npm run build

# Unprivileged nginx: runs rootless (uid 101) and listens on 8080, so it works
# under a non-root pod securityContext without writable-dir errors.
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
COPY apps/webshop-ui/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /ui/dist /usr/share/nginx/html
EXPOSE 8080
