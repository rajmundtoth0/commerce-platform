# Shared/dev configuration. docker-compose injects its own values per service;
# this file is for running a single service locally outside compose.

APP_ENV=local
LOG_LEVEL=INFO

# Auth — shared across all services (auth-api issues, everyone verifies).
JWT_SECRET=dev-secret-change-me-in-production-0123456789

# Valkey (Redis-compatible): projections (db 0), Celery broker (db 1), backend (db 2).
VALKEY_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Per-service Postgres DSNs (each service owns its own database).
AUTH_POSTGRES_DSN=postgresql+asyncpg://commerce:commerce@localhost:5432/auth
ORDERS_POSTGRES_DSN=postgresql+asyncpg://commerce:commerce@localhost:5432/orders
BACKOFFICE_POSTGRES_DSN=postgresql+asyncpg://commerce:commerce@localhost:5432/backoffice

# webshop-api -> orders-api
ORDERS_API_URL=http://localhost:8003

# OpenTelemetry — empty disables OTLP export (instrumentation still records spans).
OTEL_EXPORTER_OTLP_ENDPOINT=
