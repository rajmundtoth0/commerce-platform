# Copy to .env for local development. docker-compose injects its own values.

# Core
APP_ENV=local
LOG_LEVEL=INFO
SERVICE_NAME=commerce-platform

# Postgres (source of truth)
POSTGRES_DSN=postgresql+asyncpg://commerce:commerce@localhost:5432/commerce

# Redis (versioned read projections)
REDIS_URL=redis://localhost:6379/0

# OpenTelemetry — leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable export.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=1.0
